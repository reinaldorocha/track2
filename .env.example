# ==============================================================================
# UTM-TRACK — CONFIGURAÇÃO OFICIAL DE VARIÁVEIS DE AMBIENTE (PRODUÇÃO & DEV)
# ==============================================================================
# Instruções:
# 1. Copie este arquivo para .env.local (ambiente local) ou insira as variáveis
#    no painel do provedor de deploy (Vercel, Railway, Render, VPS).
# 2. NUNCA faça commit de credenciais reais em repositórios de controle de versão.
# ==============================================================================

# ==============================================================================
# 1. VARIÁVEIS OBRIGATÓRIAS (Essenciais para Inicialização do Sistema)
# ==============================================================================

# URL Pública da Aplicação (usada em redirects, webhooks, tracker.js e deep links)
# Em desenvolvimento: http://localhost:3000
# Em produção: https://app.seudominio.com (sem barra no final)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# URL base do NextAuth (deve coincidir com NEXT_PUBLIC_APP_URL)
NEXTAUTH_URL="http://localhost:3000"

# Chave de assinatura para sessões JWT do NextAuth (mínimo 32 caracteres)
# Gerar via terminal: openssl rand -base64 32
NEXTAUTH_SECRET="gerar-chave-secreta-jwt-min-32-caracteres-aqui"
AUTH_SECRET="gerar-chave-secreta-jwt-min-32-caracteres-aqui"

# Chave Mestre de Criptografia AES-256-GCM (64 caracteres hexadecimais = 32 bytes)
# Utilizada para cifrar tokens de acesso da Meta e segredos de webhook no banco
# Gerar via terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="gerar-chave-hexadecimal-de-64-caracteres-aqui"

# Conexão com o Banco de Dados
# Desenvolvimento local (SQLite):
DATABASE_URL="file:./dev.db"
# Produção (PostgreSQL / Supabase / Neon / AWS RDS / Vercel Postgres):
# DATABASE_URL="postgresql://usuario:senha@host:5432/utmtrack?schema=public&sslmode=require"

# ==============================================================================
# 2. PRODUÇÃO & AMBIENTE (Opcionais / Gerenciados pela Plataforma)
# ==============================================================================

NODE_ENV="development" # Em produção: "production"
PORT=3000

# ==============================================================================
# 3. SEGURANÇA & AUTENTICAÇÃO
# ==============================================================================

# Permite que o NextAuth reconheça headers de proxies e CDN (Vercel, Cloudflare)
AUTH_TRUST_HOST=true

# ==============================================================================
# 4. INTEGRAÇÕES DE MARKETING & ANÚNCIOS (Meta Ads Graph API v21.0 & CAPI)
# ==============================================================================

# Criar aplicativo em: https://developers.facebook.com/apps
# Permissões necessárias: ads_read, ads_management, business_management
META_APP_ID="seu_meta_app_id_aqui"
META_APP_SECRET="seu_meta_app_secret_aqui"

# Token de Sistema de longa duração (opcional caso utilize OAuth individual)
META_ACCESS_TOKEN=""

# Token de verificação para Webhooks da Meta
META_VERIFY_TOKEN="seu_token_de_verificacao_meta"

# ==============================================================================
# 5. GATEWAYS DE PAGAMENTO & WEBHOOKS
# ==============================================================================

# Hotmart: Configurar webhook em Ferramentas → Webhooks no painel da Hotmart
# Inserir o token de autenticação (hottok)
HOTMART_WEBHOOK_SECRET="seu_hotmart_hottok_aqui"
HOTMART_CLIENT_ID=""
HOTMART_CLIENT_SECRET=""

# Shopify: Criar App customizado e cadastrar webhook topic orders/paid e refunds/create
# Validado via HMAC-SHA256
SHOPIFY_WEBHOOK_SECRET="seu_shopify_webhook_secret_aqui"
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""

# Yampi: Webhook configurado no painel da Yampi com autenticação Bearer
YAMPI_WEBHOOK_SECRET="seu_yampi_webhook_secret_aqui"
YAMPI_USER_TOKEN=""
YAMPI_SECRET_KEY=""

# Cakto / Cacto: Webhook de vendas e contestações
CACTO_WEBHOOK_SECRET="seu_cacto_webhook_secret_aqui"
CACTO_API_KEY=""

# ==============================================================================
# 6. MOBILE & PUSH NOTIFICATIONS (Firebase FCM & Apple APNs)
# ==============================================================================

# Firebase Cloud Messaging (Android & Web Push)
# Obtenha a Server Key no Console do Firebase → Configurações do Projeto → Cloud Messaging
FCM_SERVER_KEY="sua_fcm_server_key_aqui"
FIREBASE_SERVER_KEY="sua_fcm_server_key_aqui"

# Credenciais de Conta de Serviço Firebase (para envio via Firebase Admin SDK)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Apple Push Notification Service (iOS Nativo)
# Gerado no portal Apple Developer → Certificates, Identifiers & Profiles → Keys
APNS_KEY_ID=""
APNS_TEAM_ID=""
APNS_AUTH_KEY=""
APNS_TOPIC="com.utmtrack.app"

# ==============================================================================
# 7. NOTIFICAÇÕES & E-MAIL TRANSACIONAL (Opcional)
# ==============================================================================

# Resend: https://resend.com
RESEND_API_KEY=""
EMAIL_FROM="UTM-Track <notificacoes@seudominio.com>"